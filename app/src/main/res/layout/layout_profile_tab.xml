<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileTabImage"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_wireframe"
                app:shapeAppearanceOverlay="@style/ProfileImageShape" />

            <TextView
                android:id="@+id/profileTabName"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Dayani User"
                android:textColor="#151515"
                android:textSize="27sp" />

            <TextView
                android:id="@+id/profileTabContact"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_regular"
                android:text="+94 77****123"
                android:textColor="#8A8A8A"
                android:textSize="14sp" />
        </LinearLayout>

        <include
            android:id="@+id/profileRowEditProfile"
            layout="@layout/item_settings_row" />

        <include
            android:id="@+id/profileRowAddress"
            layout="@layout/item_settings_row" />


        <include
            android:id="@+id/profileRowSecurity"
            layout="@layout/item_settings_row" />

        <include
            android:id="@+id/profileRowPrivacy"
            layout="@layout/item_settings_row" />

        <include
            android:id="@+id/profileRowHelp"
            layout="@layout/item_settings_row" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                android:id="@+id/profileRowCustomerSupport"
                layout="@layout/item_settings_row" />

            <View
                android:id="@+id/profileRowCustomerSupportDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_notification_dot"
                android:visibility="gone" />
        </FrameLayout>

        <include
            android:id="@+id/profileRowLogout"
            layout="@layout/item_settings_row" />
    </LinearLayout>
</ScrollView>
