<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trackOrderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/topBarTrack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackTrack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Track Order"
            android:textColor="#111111"
            android:textSize="20sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTrackOrder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="0dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarTrack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerTrackProducts"
                android:layout_width="match_parent"
                android:layout_height="134dp" />

            <LinearLayout
                android:id="@+id/layoutTrackDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone" />

            <!-- Status icons row -->
            <LinearLayout
                android:id="@+id/layoutTrackSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/stepPlacedBg"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_track_step_neutral">

                        <ImageView
                            android:id="@+id/imgStepPlaced"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_order_step_placed" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/stepProcessingBg"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_track_step_neutral">

                        <ImageView
                            android:id="@+id/imgStepProcessing"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_order_step_processing" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/stepShippedBg"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_track_step_neutral">

                        <ImageView
                            android:id="@+id/imgStepShipped"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_order_step_shipped" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/stepDeliveredBg"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_track_step_neutral">

                        <ImageView
                            android:id="@+id/imgStepDelivered"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_order_step_delivered" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Tick row -->
            <LinearLayout
                android:id="@+id/layoutTrackChecks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <!-- Tick 1 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1">

                    <FrameLayout
                        android:id="@+id/checkPlacedBg"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_track_check_circle_active">

                        <TextView
                            android:id="@+id/txtCheckPlaced"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="✓"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Tick 2 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1">

                    <FrameLayout
                        android:id="@+id/checkProcessingBg"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_track_check_circle_inactive">

                        <TextView
                            android:id="@+id/txtCheckProcessing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="✓"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Tick 3 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1">

                    <FrameLayout
                        android:id="@+id/checkShippedBg"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_track_check_circle_inactive">

                        <TextView
                            android:id="@+id/txtCheckShipped"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="✓"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Tick 4 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1">

                    <FrameLayout
                        android:id="@+id/checkDeliveredBg"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_track_check_circle_inactive">

                        <TextView
                            android:id="@+id/txtCheckDelivered"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="✓"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCheckLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="40dp"
                android:paddingEnd="40dp">

                <View
                    android:id="@+id/lineCheckPlacedProcessing"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:alpha="1"
                    android:background="@drawable/bg_track_line_inactive" />

                <Space
                    android:layout_width="34dp"
                    android:layout_height="1dp" />

                <View
                    android:id="@+id/lineCheckProcessingShipped"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:alpha="0.40"
                    android:background="@drawable/bg_track_line_inactive" />

                <Space
                    android:layout_width="34dp"
                    android:layout_height="1dp" />

                <View
                    android:id="@+id/lineCheckShippedDelivered"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:alpha="0.40"
                    android:background="@drawable/bg_track_line_inactive" />
            </LinearLayout>

            <View
                android:id="@+id/dividerTrackTop"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="25dp"
                android:background="#EAEAEA" />

            <TextView
                android:id="@+id/txtCurrentTrackStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Order Status Details"
                android:textColor="#171717"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/layoutStatusTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <!-- Placed -->
                <LinearLayout
                    android:id="@+id/rowPlaced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="top|center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/rowPlacedOuter"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_track_timeline_circle_inactive"
                            android:padding="4dp">

                            <View
                                android:id="@+id/rowPlacedDot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_track_status_dot_active" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtPlacedTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Order Placed"
                                android:textColor="#171717"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/txtPlacedTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Mar 27, 09:29 AM"
                                android:textColor="#7A7A7A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtPlacedMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Order placed successfully"
                            android:textColor="#8A8A8A"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linePlacedVerticalWrap"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="match_parent"
                        android:foregroundGravity="center">

                        <View
                            android:id="@+id/linePlacedVertical"
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:background="@drawable/bg_track_vertical_dotted" />
                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Processing -->
                <LinearLayout
                    android:id="@+id/rowProcessing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="top|center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/rowProcessingOuter"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_track_timeline_circle_inactive"
                            android:padding="4dp">

                            <View
                                android:id="@+id/rowProcessingDot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_track_timeline_circle_inactive" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtProcessingTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Order Processing"
                                android:textColor="#171717"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/txtProcessingTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Mar 27, 10:10 AM"
                                android:textColor="#7A7A7A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtProcessingMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Your order is being prepared"
                            android:textColor="#8A8A8A"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lineProcessingVerticalWrap"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="match_parent">

                        <View
                            android:id="@+id/lineProcessingVertical"
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:background="@drawable/bg_track_vertical_dotted" />
                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Shipped -->
                <LinearLayout
                    android:id="@+id/rowShipped"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="top|center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/rowShippedOuter"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_track_timeline_circle_inactive"
                            android:padding="4dp">

                            <View
                                android:id="@+id/rowShippedDot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_track_timeline_circle_inactive" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtShippedTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Packet In Delivery"
                                android:textColor="#171717"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/txtShippedTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Mar 27, 11:35 AM"
                                android:textColor="#7A7A7A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtShippedMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Your order is out for delivery"
                            android:textColor="#8A8A8A"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lineShippedVerticalWrap"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="match_parent">

                        <View
                            android:id="@+id/lineShippedVertical"
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:background="@drawable/bg_track_vertical_dotted" />
                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Delivered -->
                <LinearLayout
                    android:id="@+id/rowDelivered"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="top|center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/rowDeliveredOuter"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_track_timeline_circle_inactive"
                            android:padding="4dp">

                            <View
                                android:id="@+id/rowDeliveredDot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_track_timeline_circle_inactive" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtDeliveredTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Order Delivered"
                                android:textColor="#171717"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/txtDeliveredTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Mar 27, 01:15 PM"
                                android:textColor="#7A7A7A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtDeliveredMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Your order has been delivered"
                            android:textColor="#8A8A8A"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>