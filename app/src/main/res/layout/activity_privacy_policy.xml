<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="0dp"
                android:src="@drawable/ic_back"
                app:tint="#111111" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Privacy Policy"
                android:textColor="#1B1B1B"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/poppins_bold"
            android:text="1. Information We Collect"
            android:textColor="#202020"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="Dayani Super Center collects only the information needed to create your account, fulfill orders, provide delivery updates, answer support requests, and improve the shopping experience. This can include your name, phone number, email address, delivery address, device information, and the payment option you choose at checkout."
            android:textColor="#6B6B6B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/poppins_bold"
            android:text="2. How Your Data Is Used"
            android:textColor="#202020"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="Your data is used to authenticate your account, process purchases, coordinate delivery, protect your profile with security features such as your app PIN, and provide customer support. We may also use general usage patterns to improve app performance, navigation, and product presentation."
            android:textColor="#6B6B6B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/poppins_bold"
            android:text="3. Sharing and Retention"
            android:textColor="#202020"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="We do not sell personal information. Data is shared only with service providers required for app operations, such as authentication, cloud storage, map services, and payment processing. Information is retained only as long as needed for account management, legal compliance, fraud prevention, and support history."
            android:textColor="#6B6B6B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/poppins_bold"
            android:text="4. Your Choices"
            android:textColor="#202020"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="You can update your profile details, addresses, and security preferences inside the app. You can also contact Dayani Super Center support to request corrections, order help, or account-related assistance. Continued use of the application means you agree to this privacy policy and any future updates published through the app or the official website."
            android:textColor="#6B6B6B"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
