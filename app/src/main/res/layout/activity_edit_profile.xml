<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="22dp"
        android:padding="0dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#111111" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Edit Profile"
        android:textColor="#1B1B1B"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="96dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:layout_width="132dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile_wireframe"
                        app:shapeAppearanceOverlay="@style/ProfileImageShape" />

                    <ImageView
                        android:id="@+id/btnChangePhoto"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_edit_photo_badge"
                        android:elevation="4dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_profile_edit_badge_custom"
                        app:tint="@null" />
                </FrameLayout>
            </FrameLayout>

            <EditText
                android:id="@+id/edtName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/poppins_regular"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#111111"
                android:textColorHint="#A0A0A0"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtDob"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_input"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_calendar_small"
                android:drawablePadding="12dp"
                android:focusable="false"
                android:fontFamily="@font/poppins_regular"
                android:hint="Date of Birth"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#111111"
                android:textColorHint="#A0A0A0"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_input_disabled"
                android:drawableEnd="@drawable/ic_mail_outline"
                android:drawablePadding="12dp"
                android:fontFamily="@font/poppins_regular"
                android:hint="Email"
                android:inputType="none"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:cursorVisible="false"
                android:longClickable="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#777777"
                android:textColorHint="#A0A0A0"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/poppins_regular"
                android:hint="Phone Number"
                android:inputType="phone"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#111111"
                android:textColorHint="#A0A0A0"
                android:textSize="15sp" />

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/edtGender"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_input"
                android:drawableEnd="@drawable/ic_arrow_drop"
                android:drawablePadding="12dp"
                android:focusable="false"
                android:fontFamily="@font/poppins_regular"
                android:hint="Gender"
                android:inputType="none"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#111111"
                android:textColorHint="#A0A0A0"
                android:textSize="15sp"
                android:dropDownHeight="wrap_content"
                android:popupBackground="@drawable/bg_dropdown_popup" />


        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_black_pill"
        android:text="Update"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
